<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        Who owns this project and what is it called.
        groupId   = your organisation, written like a reversed domain name
        artifactId = the name of this specific project
        version    = current version (SNAPSHOT means still in development)
        packaging  = pom means this is a parent/container project, not a runnable app
    -->
    <groupId>com.bankplatform</groupId>
    <artifactId>bank-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Bank Platform</name>

    <!--
        Every service module in the project is listed here.
        When you run mvn install from this folder, Maven builds
        them in this order. shared-kernel MUST be first because
        every other module imports it as a dependency.
    -->
    <modules>
        <module>shared-kernel</module>
        <module>auth-service</module>
        <module>identity-service</module>
        <module>account-service</module>
        <module>ledger-service</module>
<!--        <module>transfer-service</module>-->
<!--        <module>card-service</module>-->
<!--        <module>notification-service</module>-->
<!--        <module>api-gateway</module>-->
    </modules>

    <!--
        Variables. Define a version number once, use it everywhere.
        To upgrade Spring Boot across all 9 services, change one line here.
    -->
    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-boot.version>3.3.4</spring-boot.version>
        <spring-cloud.version>2023.0.3</spring-cloud.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <lombok.version>1.18.34</lombok.version>
        <logstash-logback.version>7.4</logstash-logback.version>
        <jjwt.version>0.12.6</jjwt.version>
        <flyway.version>10.15.2</flyway.version>
        <testcontainers.version>1.20.1</testcontainers.version>
        <archunit.version>1.3.0</archunit.version>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
    </properties>

    <!--
        dependencyManagement declares versions but does NOT add
        any dependency to any module. A child module that wants
        Spring Boot web simply declares spring-boot-starter-web
        with no version tag. Maven looks here for the version.

        The two <type>pom</type><scope>import</scope> entries are
        called BOMs (Bill of Materials). Spring Boot's BOM alone
        manages the versions of 300+ libraries so they all
        work together without conflicts.
    -->
    <dependencyManagement>
        <dependencies>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Our own shared-kernel module -->
            <dependency>
                <groupId>com.bankplatform</groupId>
                <artifactId>shared-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- MapStruct: generates mapper code at compile time -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- Structured JSON logging -->
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback.version}</version>
            </dependency>

            <!-- JWT: issue and validate tokens -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!-- ArchUnit: architecture tests that fail if you break hexagonal rules -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!--
        These dependencies ARE added to every single child module
        automatically. Keep this list very short — only things that
        are genuinely needed by every service without exception.
    -->
    <dependencies>

        <!-- Lombok: removes boilerplate (getters, constructors, builders)
             scope=provided means it is used at compile time only,
             it is NOT included in the final JAR that runs in production -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Test framework: every service needs this for writing tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <pluginManagement>
            <plugins>

                <!--
                    Packages each service as a fat runnable JAR.
                    "Fat" means all dependencies are bundled inside the JAR
                    so you can run it with: java -jar service.jar
                    without needing any external classpath.
                -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                    <executions>
                        <execution>
                            <goals><goal>repackage</goal></goals>
                        </execution>
                    </executions>
                </plugin>

                <!--
                    Tells the Java compiler to use Java 21.
                    Also configures annotation processors — these are
                    tools that run DURING compilation and generate code
                    for you. Lombok and MapStruct are both annotation
                    processors. Lombok MUST come before MapStruct in
                    this list because MapStruct reads the getters that
                    Lombok generates. Wrong order = compile error.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <!--
                    Runs your unit tests when you type mvn test.
                    The JVM arg below is needed for Spring Boot 3
                    with Java 21 to avoid a warning during testing.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                    </configuration>
                </plugin>

                <!--
                    Flyway runs SQL migration scripts automatically
                    when a service starts up. It creates your database
                    tables for you so you never write CREATE TABLE
                    commands manually in production.
                -->
                <plugin>
                    <groupId>org.flywaydb</groupId>
                    <artifactId>flyway-maven-plugin</artifactId>
                    <version>${flyway.version}</version>
                </plugin>

            </plugins>
        </pluginManagement>
    </build>

</project>