<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        This links the module back to the parent.
        Maven walks up to the parent pom.xml and inherits
        all version management and plugin configuration from it.
    -->
    <parent>
        <groupId>com.bankplatform</groupId>
        <artifactId>bank-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>shared-kernel</artifactId>
    <packaging>jar</packaging>
    <name>Shared Kernel</name>

    <dependencies>

        <!-- Web: needed for Filter, @RestControllerAdvice -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Kafka: needed for event records and Kafka MDC interceptor -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Validation: @NotNull, @NotBlank, @Email annotations -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator: health and metrics endpoints for every service -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Data Commons: provides Page, Pageable, Sort.
     Added here so PageResponse can use Page<T> without
     pulling in the full JPA/Hibernate stack.
     spring-data-commons is the lightweight core that
     contains only the data access abstractions. -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>

        <!-- Micrometer tracing: injects traceId into MDC automatically -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>
        <dependency>
            <groupId>io.zipkin.reporter2</groupId>
            <artifactId>zipkin-reporter-brave</artifactId>
        </dependency>

        <!-- Structured JSON logging -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>

        <!-- Jackson date/time support -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Required by MapStruct annotation processor on Java 9+.
     The JDK no longer bundles javax.annotation by default.
     Without this, MapStruct fails with "When.MAYBE not found"
     even if you have no mappers in this module yet —
     the processor still loads and looks for this class. -->
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
            <version>3.0.2</version>
        </dependency>

        <!-- ArchUnit: enforces hexagonal architecture rules as tests.
     Reads compiled bytecode and fails the build if any class
     violates the rules defined in HexagonalArchitectureTest.
     scope=test means it is only on the test classpath —
     never packaged into the shared-kernel JAR itself. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                shared-kernel is a library, not a runnable app.
                Disabling this plugin prevents Maven from packaging
                it as a fat boot JAR, which other modules cannot import.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>

            <!--
                Produces a second JAR called shared-kernel-0.0.1-SNAPSHOT-tests.jar
                that contains the test classes (src/test/java).
                Other modules can import this JAR with classifier=tests
                to access shared test utilities like HexagonalArchitectureTest.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>